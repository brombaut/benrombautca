{#
  One chip per icon+label pair. Renders a link when the entry has a url and a
  plain span otherwise, so the same macro covers both external repos and tech
  used. The meta JSON already carries imagePath, title and url, which is why
  ExternalRepoIcon.vue and TechUsedIcon.vue are gone rather than ported.
#}
{% macro chips(items) %}
  {% if items.length %}
    <ul class="chips">
      {% for item in items %}
        <li>
          {% if item.url %}
            <a class="chip" href="{{ item.url }}" target="_blank" rel="noopener">
              <img src="/images/{{ item.imagePath }}" alt="" width="16" height="16">
              {{ item.hoverText or item.title }}
            </a>
          {% else %}
            <span class="chip">
              <img src="/images/{{ item.imagePath }}" alt="" width="16" height="16">
              {{ item.title }}
            </span>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% endif %}
{% endmacro %}
