---
layout: base.njk
---
{#
  The representative page for #535: hero, button pair, pull-quote, angled
  separator, and the dated list with a disclosure. #542 rewrites this copy.
#}
<section class="hero">
  <h1>Hi, I'm Ben.</h1>
  {{ aboutMe.description | safe }}

  <div class="buttons">
    <a class="button button--filled" href="/blog/">Read the blog</a>
    <a class="button button--outline" href="/resumes/BenRombaut_CV.pdf">Curriculum vitae</a>
  </div>
</section>

<hr class="separator">

<h2>Writing</h2>
<ul class="dated-list">
  {% for post in blog.listed.slice(0, 5) %}
    <li>
      <time datetime="{{ post.createdAt }}">{{ post.createdAt | shortDate }}</time>
      <div>
        <a class="dated-list__title" href="{{ post.url }}">{{ post.emoji }} {{ post.displayTitle }}</a>
        <p class="dated-list__meta">{{ post.readingMinutes }} min read</p>
      </div>
    </li>
  {% endfor %}
</ul>

{% if blog.listed.length > 5 %}
  <details class="disclosure">
    <summary>Earlier posts</summary>
    <ul class="dated-list">
      {% for post in blog.listed.slice(5) %}
        <li>
          <time datetime="{{ post.createdAt }}">{{ post.createdAt | shortDate }}</time>
          <div>
            <a class="dated-list__title" href="{{ post.url }}">{{ post.emoji }} {{ post.displayTitle }}</a>
            <p class="dated-list__meta">{{ post.readingMinutes }} min read</p>
          </div>
        </li>
      {% endfor %}
    </ul>
  </details>
{% endif %}
